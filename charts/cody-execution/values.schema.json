{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "sandbox": {
      "type": "object",
      "required": [
        "idleTimeout",
        "retention",
        "resources"
      ],
      "properties": {
        "idleTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "retention": {
          "type": "string",
          "pattern": "^(2[4-9]|[3-9][0-9]|[1-9][0-9]{2,})h$"
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ],
                  "minLength": 1
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ],
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ],
                  "minLength": 1
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ],
                  "minLength": 1
                }
              }
            }
          }
        },
        "workspaceSize": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\+?([0-9]*[1-9][0-9]*(\\.[0-9]+)?|[0-9]*\\.[0-9]*[1-9][0-9]*)([eE][+-]?[0-9]+|[numkMGTPE]|[KMGTPE]i)?$"
        },
        "storageClass": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        }
      },
      "additionalProperties": false
    },
    "kubernetes": {
      "type": "object",
      "properties": {
        "qps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "burst": {
          "type": "integer",
          "minimum": 1
        },
        "requestTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$",
          "not": {
            "pattern": "^(0+(\\.0+)?(ms|s|m|h))+$"
          }
        }
      }
    },
    "image": {},
    "installation": {},
    "gatewayURL": {},
    "installationTokenSecret": {},
    "gatewayCASecret": {},
    "runtimeTokenSecret": {},
    "provisioningTimeout": {},
    "receipts": {},
    "networkPolicy": {},
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_turns",
        "admission_window",
        "idle_sandboxes",
        "default_source_active_limit",
        "default_lane_active_limit"
      ],
      "properties": {
        "active_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "admission_window": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "default_source_active_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "default_lane_active_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "idle_sandboxes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "source_overrides": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource",
              "active_limit"
            ],
            "properties": {
              "resource": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "namespace",
                  "resource_id"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "resource_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              "active_limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          }
        },
        "lane_overrides": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource",
              "active_limit",
              "lane_id"
            ],
            "properties": {
              "resource": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "namespace",
                  "resource_id"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "resource_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              "active_limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "lane_id": {
                "type": "string",
                "pattern": "^(route|agent):.+",
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "assetAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "azure"
      ],
      "properties": {
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenantID",
            "clientID"
          ],
          "properties": {
            "tenantID": {
              "type": "string"
            },
            "clientID": {
              "type": "string"
            }
          }
        }
      }
    },
    "assetValidation": {
      "type": "object",
      "required": [
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi)$"
        }
      }
    },
    "installationToken": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9_-]{43}$"
    },
    "onboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "model"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "const": "cody/codex-v1"
        }
      }
    },
    "accessBroker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "azure",
        "networkPolicy"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 2
        },
        "tlsSecret": {
          "type": "string"
        },
        "feedTLSSecret": {
          "type": "string"
        },
        "caSecret": {
          "type": "string"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "identityFreshness": {
          "type": "string"
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": [
                "",
                "cilium",
                "external"
              ]
            },
            "externalEnforcementConfigured": {
              "type": "boolean"
            }
          }
        },
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "tls",
                "mesh",
                "plaintext"
              ]
            },
            "sandboxToBroker": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "tls",
                    "mesh",
                    "plaintext"
                  ]
                }
              }
            },
            "brokerToFeed": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "tls",
                    "mesh",
                    "plaintext"
                  ]
                }
              }
            }
          }
        },
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            },
            "group": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "kind": [
              "name"
            ],
            "group": [
              "name"
            ]
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "upstreamHosts"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "upstreamHosts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "scheduling"
  ]
}
